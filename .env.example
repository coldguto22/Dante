# Copy this file to .env and adjust values for your local setup.
OLLAMA_HOST=http://localhost:11434
DANTE_MODEL=llama3.1:8b
DANTE_DB_PATH=data/dante.sqlite3
DANTE_MAIN_DB_PATH=data/dante.sqlite3
DANTE_TEMPERATURE=0.8
# Context defaults to 2048 to fit llama3.1:8b on a 12 GB GPU; override for an ablation:
DANTE_NUM_CTX=2048
# DANTE_REFLECTION_TEMPERATURE=0.25
DANTE_SYSTEM_PROMPT=You are Dante, an experimental local agent. Be honest about uncertainty and propose only bounded, relevant next steps.
